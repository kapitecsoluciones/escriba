{
  "name": "escriba",
  "version": "0.8.1",
  "description": "Graba tus reuniones, transcr\u00edbelas en tu propia Mac y convierte lo hablado en una minuta con acuerdos y pendientes.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "nativo": "swiftc -O nativo/CapturaSistema.swift -o nativo/capturasistema",
    "dist": "pnpm run nativo && electron-builder --mac --arm64",
    "test": "node --test \"test/*.test.js\""
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "author": "Kapitec Soluciones",
  "homepage": "https://escriba.kapitec.pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/kapitecsoluciones/escriba.git"
  },
  "build": {
    "appId": "pro.kapitec.escriba",
    "productName": "Escriba",
    "copyright": "Copyright \u00a9 2026 Kapitec Soluciones",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "nativo/capturasistema",
        "to": "capturasistema"
      },
      {
        "from": "build/marca/icono-512.png",
        "to": "icono-512.png"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/marca/escriba.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Para grabar tu voz durante la reuni\u00f3n.",
        "NSScreenCaptureUsageDescription": "Para grabar el audio de tus videollamadas."
      }
    },
    "dmg": {
      "title": "Escriba",
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterPack": "build/firmar.js"
  },
  "packageManager": "pnpm@11.5.0"
}
